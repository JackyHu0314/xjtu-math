---
import resources from '../data/resources.json';

interface Props {
	course: string;
}
const { course } = Astro.props;
const data: Record<string, any> = (resources as any)[course] ?? {};
// 文件根地址：本地和 Cloudflare Pages 上都是 /files
const base = (import.meta.env.PUBLIC_FILES_BASE ?? '/files').replace(/\/$/, '');
const order = ['真题', '练习题', '讲义与复习'];
const idx = (k: string) => (order.includes(k) ? order.indexOf(k) : 99);
const groups = Object.keys(data)
	.filter((k) => k !== 'books')
	.sort((a, b) => idx(a) - idx(b));
const fileUrl = (p: string) => base + '/' + p.split('/').map(encodeURIComponent).join('/');
// PDF 用 PDF.js 在线预览，其他格式直接下载
const previewUrl = (f: any) => (f.ext === 'PDF' ? '/pdfjs/web/viewer.html?file=' + encodeURIComponent(fileUrl(f.path)) : fileUrl(f.path));
// 真题、练习题缺班型、学期、任课时，标「未知」并给出补充链接（GitHub「资料信息补充」表单，预填资料路径）
const REPO = 'https://github.com/JackyHu0314/xjtu-math';
const needInfo = (g: string) => g === '真题' || g === '练习题';
const KEY_FIELDS: [string, string][] = [['cls', '班型'], ['termLabel', '学期'], ['teacher', '任课']];
groups.forEach((g) =>
	data[g].forEach((f: any) => {
		f.missing = needInfo(g) ? KEY_FIELDS.filter(([k]) => !f[k]).map(([, label]) => label) : [];
		f.needFix = f.missing.length > 0;
	}),
);
const unknown = (f: any, k: string, label: string) => f[k] || (f.missing?.includes(label) ? '未知' : '');
// 本课程投稿链接：GitHub「资料投稿」表单，预填课程名
const submitUrl = `${REPO}/issues/new?template=submit.yml&title=${encodeURIComponent('[投稿] ' + course)}&course=${encodeURIComponent(course)}`;
// 每份资料下方的带字段名信息
const fields = (f: any) =>
	[
		['学期', unknown(f, 'termLabel', '学期')],
		['年级', f.grade],
		['班型', unknown(f, 'cls', '班型')],
		['任课', unknown(f, 'teacher', '任课')],
		['作者', f.author],
		['上传', f.contributor],
		['备注', f.note],
	].filter(([, v]) => v) as [string, string][];
const allFiles = groups.flatMap((g) => data[g]);
const uniq = (key: string) => [...new Set(allFiles.map((f: any) => f[key]).filter(Boolean))] as string[];
// 筛选：按任课老师、班型，两组可以组合
const filterGroups = [
	{ k: 't', label: '任课', values: uniq('teacher') },
	{ k: 'c', label: '班型', values: uniq('cls') },
].filter((g) => g.values.length);
---

<div class="res not-content" id="res">
	<div class="submit-row">
		<a class="submit" href={submitUrl} target="_blank" rel="noopener">投稿本课程资料</a>
	</div>
	{
		filterGroups.length > 0 && (
			<div class="filters">
				{filterGroups.map((g) => (
					<div class="frow" data-k={g.k}>
						<span class="flabel">{g.label}</span>
						<button class="fchip on" data-v="">全部</button>
						{g.values.map((v) => (
							<button class="fchip" data-v={v}>{v}</button>
						))}
					</div>
				))}
			</div>
		)
	}
	<div class="empty none" hidden>没有符合条件的资料。</div>
	{groups.length === 0 && <div class="empty">暂无资料。</div>}
	{
		groups.map((g) => (
			<section>
				<div class="gh">
					<span class="gt">{g}</span>
					<span class="gc">{data[g].length}</span>
				</div>
				<div class={data[g].some((f: any) => f.needFix) ? 'list has-fix' : 'list'}>
					{data[g].map((f: any) => (
						<div class="res-item" data-t={f.teacher} data-c={f.cls}>
							<a class="main" href={previewUrl(f)} target="_blank" rel="noopener">
								<span class={`ext ext-${f.ext.toLowerCase()}`}>{f.ext}</span>
								<span class="nm-wrap">
									<span class="nm">
										{f.name}
										{f.answer && <span class="ans">含答案</span>}
									</span>
									{fields(f).length > 0 && (
										<span class="meta">
											{fields(f).map(([k, v]) => (
												<span class="kv"><i>{k}</i>{v}</span>
											))}
										</span>
									)}
								</span>
								<span class="sz">{f.size}</span>
							</a>
							{f.answerPath && (
								<a class="anslink" href={previewUrl({ ext: f.answerPath.split('.').pop().toUpperCase(), path: f.answerPath })} target="_blank" rel="noopener">答案</a>
							)}
							<a class="dl" href={fileUrl(f.path)} download title="下载" aria-label={`下载 ${f.name}`}>↓</a>
							{f.needFix && (
								<button type="button" class="fix" data-path={f.path} data-title={f.name} title={`缺：${f.missing.join('、')}`}>补充信息</button>
							)}
						</div>
					))}
				</div>
			</section>
		))
	}
	{
		data.books && (
			<section>
				<div class="gh">
					<span class="gt">教材</span>
					<span class="gc">{data.books.length}</span>
				</div>
				<div class="books">
					{data.books.map((b: string) => (
						<span class="book">{b}</span>
					))}
				</div>
				<p class="note">目前收集到的版本，不代表推荐；各老师实际使用的教材待补充。受版权保护，只列书名。</p>
			</section>
		)
	}
	<form class="fb" hidden>
		<div class="fb-title"></div>
		<div class="fb-row">
			<label>班型
				<select name="cls">
					<option value="">不填</option>
					<option>数学大类</option>
					<option>强基</option>
					<option>数学试验班</option>
					<option>几个班共用</option>
				</select>
			</label>
			<label>学期<input name="term" maxlength="40" placeholder="如 2024-2025 春" /></label>
			<label>任课老师<input name="teacher" maxlength="40" /></label>
		</div>
		<label class="fb-note">其他<input name="note" maxlength="500" placeholder="例如年份写错了" /></label>
		<div class="fb-actions">
			<span class="fb-msg"></span>
			<button type="button" class="fb-cancel">取消</button>
			<button type="submit" class="fb-submit">提交</button>
		</div>
	</form>
</div>

<script>
	// 补充信息：点按钮在该资料下方展开表单，提交到 /api/feedback（不需要登录）
	document.querySelectorAll<HTMLElement>('.res').forEach((root) => {
		const form = root.querySelector<HTMLFormElement>('.fb');
		if (!form) return;
		const msg = form.querySelector<HTMLElement>('.fb-msg')!;
		let current: HTMLButtonElement | null = null;
		const close = () => {
			form.hidden = true;
			form.reset();
			msg.textContent = '';
			current = null;
		};
		root.querySelectorAll<HTMLButtonElement>('.fix').forEach((btn) =>
			btn.addEventListener('click', () => {
				if (current === btn) return close();
				close();
				current = btn;
				form.querySelector<HTMLElement>('.fb-title')!.textContent = '补充：' + btn.dataset.title + '（' + btn.title + '）';
				btn.closest('.res-item')!.after(form);
				form.hidden = false;
			}),
		);
		form.querySelector('.fb-cancel')!.addEventListener('click', close);
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!current) return;
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			if (!data.cls && !data.term?.trim() && !data.teacher?.trim() && !data.note?.trim()) {
				msg.textContent = '至少填一项';
				return;
			}
			msg.textContent = '提交中…';
			try {
				const res = await fetch('/api/feedback', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ ...data, path: current.dataset.path, title: current.dataset.title }),
				});
				const out = await res.json().catch(() => ({}));
				if (res.ok && out.ok) {
					msg.textContent = '已收到，审核后更新。谢谢！';
					const btn = current;
					btn.textContent = '已提交';
					btn.disabled = true;
					setTimeout(close, 1800);
				} else {
					msg.textContent = out.error || '提交失败，请稍后再试';
				}
			} catch {
				msg.textContent = '网络错误，请稍后再试';
			}
		});
	});

	document.querySelectorAll<HTMLElement>('.res').forEach((root) => {
		const state: Record<string, string> = {};
		const apply = () => {
			root.querySelectorAll<HTMLElement>('.res-item').forEach((it) => {
				it.hidden = Object.entries(state).some(([k, v]) => v && it.dataset[k] !== v);
			});
			root.querySelectorAll<HTMLElement>('section').forEach((sec) => {
				sec.hidden = sec.querySelector('.res-item') !== null && !sec.querySelector('.res-item:not([hidden])');
			});
			const none = root.querySelector<HTMLElement>('.none');
			if (none) none.hidden = !!root.querySelector('.res-item:not([hidden])') || !root.querySelector('.res-item');
		};
		root.querySelectorAll<HTMLElement>('.frow').forEach((row) => {
			row.querySelectorAll<HTMLButtonElement>('.fchip').forEach((b) =>
				b.addEventListener('click', () => {
					row.querySelectorAll('.fchip').forEach((x) => x.classList.toggle('on', x === b));
					state[row.dataset.k!] = b.dataset.v ?? '';
					apply();
				}),
			);
		});
	});
</script>

<style>
	.res {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-top: 1rem;
	}
	.submit-row {
		display: flex;
		justify-content: flex-end;
		margin-bottom: -1rem;
	}
	.submit {
		font-size: 0.85rem;
		font-weight: 500;
		padding: 0.4rem 0.95rem;
		border-radius: 8px;
		background: var(--clay);
		color: #fff !important;
		text-decoration: none;
	}
	.submit:hover {
		background: var(--clay-active);
	}
	.filters {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin-bottom: -0.6rem;
	}
	.frow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}
	.flabel {
		width: 2.5rem;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.fchip {
		font: inherit;
		font-size: 0.82rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.fchip.on {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}
	.res-item[hidden],
	.empty[hidden],
	section[hidden] {
		display: none;
	}
	.gh {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-bottom: 0.75rem;
	}
	.gt {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.gc {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.1rem 0.6rem;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--muted);
	}
	.list {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--paper);
	}
	.res-item:first-child {
		border-radius: 11px 11px 0 0;
	}
	.res-item:last-child {
		border-radius: 0 0 11px 11px;
	}
	.res-item:only-child {
		border-radius: 11px;
	}
	/* 宽屏：「补充班型」放到资料框外、下载按钮右边 */
	@media (min-width: 900px) {
		.list.has-fix {
			margin-right: 6rem;
		}
		.res-item {
			position: relative;
		}
		.fix {
			position: absolute;
			left: calc(100% + 0.8rem);
			top: 50%;
			transform: translateY(-50%);
			margin-right: 0;
		}
	}
	.res-item {
		display: flex;
		align-items: center;
		transition: background 0.12s;
	}
	.res-item + .res-item {
		border-top: 1px solid var(--line);
	}
	.res-item:hover {
		background: var(--surface);
	}
	.main {
		flex: 1;
		min-width: 0;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.9rem;
		padding: 0.8rem 0.4rem 0.8rem 1.1rem;
		text-decoration: none;
		color: var(--ink);
	}
	.ext {
		font-family: var(--sl-font-mono);
		font-size: 0.66rem;
		font-weight: 600;
		width: 40px;
		text-align: center;
		padding: 0.22rem 0;
		border-radius: 4px;
		background: var(--surface-2);
		color: var(--muted);
	}
	.ext-pdf {
		background: var(--clay-soft);
		color: var(--clay-active);
	}
	.nm-wrap {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.nm {
		font-size: 0.95rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ans {
		display: inline-block;
		margin-left: 0.5rem;
		font-size: 0.7rem;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		vertical-align: 0.1em;
		background: color-mix(in srgb, #5db872 16%, transparent);
		color: #3f8f53;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 0.9rem;
		margin-top: 0.2rem;
		font-size: 0.76rem;
		color: var(--sl-color-gray-2);
	}
	.kv i {
		font-style: normal;
		color: var(--muted);
		margin-right: 0.3rem;
	}
	.sz {
		font-size: 0.8rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.anslink {
		flex: none;
		margin-right: 0.6rem;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.18rem 0.7rem;
		border-radius: 999px;
		background: color-mix(in srgb, #5db872 16%, transparent);
		color: #3f8f53;
		text-decoration: none;
		white-space: nowrap;
	}
	.anslink:hover {
		background: #3f8f53;
		color: #fff;
	}
	.fix {
		flex: none;
		margin-right: 0.6rem;
		font-size: 0.75rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px dashed var(--line);
		color: var(--muted);
		text-decoration: none;
		white-space: nowrap;
	}
	.fix {
		font: inherit;
		font-size: 0.75rem;
		background: none;
		cursor: pointer;
	}
	.fix:disabled {
		cursor: default;
		border-style: solid;
	}
	.fb {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0.9rem 1.1rem;
		border-top: 1px solid var(--line);
		background: var(--surface);
		font-size: 0.85rem;
	}
	.fb[hidden] {
		display: none;
	}
	.fb-title {
		font-weight: 500;
		color: var(--ink);
	}
	.fb-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
	}
	.fb label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
	}
	.fb-note input {
		flex: 1;
	}
	.fb input,
	.fb select {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--paper);
		color: var(--ink);
		min-width: 0;
	}
	.fb-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.6rem;
	}
	.fb-msg {
		margin-right: auto;
		color: var(--muted);
	}
	.fb-actions button {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.3rem 0.9rem;
		border-radius: 6px;
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--ink);
		cursor: pointer;
	}
	.fb-actions .fb-submit {
		background: var(--clay);
		border-color: var(--clay);
		color: #fff;
	}
	.fix:hover {
		border-color: var(--clay);
		color: var(--clay);
	}
	.dl {
		flex: none;
		width: 30px;
		height: 30px;
		margin-right: 1rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		border: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.85rem;
		text-decoration: none;
		transition: all 0.12s;
	}
	.dl:hover {
		background: var(--clay);
		border-color: var(--clay);
		color: #fff;
	}
	.books {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.book {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.92rem;
		padding: 0.45rem 0.85rem;
		border-radius: 8px;
		background: var(--surface-2);
		color: var(--sl-color-gray-2);
	}
	.note {
		font-size: 0.8rem;
		color: var(--muted);
		margin-top: 0.7rem;
	}
	.empty {
		padding: 1.6rem;
		text-align: center;
		border-radius: 12px;
		background: var(--surface-2);
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.main {
			grid-template-columns: auto 1fr;
		}
		.sz {
			display: none;
		}
	}
</style>
